DATABASE_URL="postgresql://kmplus:kmplus@localhost:5432/kmplus_people"
# Same as DATABASE_URL locally. On Supabase, see README-DEPLOY.md → Supabase Postgres.
DIRECT_URL="postgresql://kmplus:kmplus@localhost:5432/kmplus_people"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_ORIGIN="http://localhost:3000"
# Supabase Auth holds passwords (ADR-0011). Server-only; never NEXT_PUBLIC_.
# Project Settings → API Keys. Legacy anon / service_role keys also work.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Set-password email goes out through the company mail server (ADR-0011).
# 465 = implicit TLS, 587 = STARTTLS. Unset locally: Supabase's mailer is used instead.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL is the transaction pooler (serverless); DIRECT_URL the session pooler (db push).
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String   @id
  currentRole     String
  currentPersonId String
  updatedAt       DateTime @updatedAt
}

model Person {
  id                    String   @id
  tenantId              String
  legalName             String
  preferredName         String
  email                 String
  phone                 String
  emergencyContactName  String
  emergencyContactPhone String
  linkedIn              String?
  skills                String[]
  educationNotes        String   @default("")
  experienceNotes       String   @default("")
  certifications        String   @default("")
  educations            Json
  experiences           Json
  certificationRows     Json
  skillRows             Json
  weekGrid              String   @default("weekdays")

  employments  Employment[]
  assignments  Assignment[]
  cvs          CurriculumVitae[]
  corrections  CorrectionRequest[]
  auditEntries AuditEntry[]
  users        User[]
  staffings    Staffing[]
  leaveRequests LeaveRequest[] @relation("LeaveSubject")
  leaveCovers   LeaveRequest[] @relation("LeaveCover")
  timeBlocks   TimeBlock[]
  invites      Invite[]
  workItemPics WorkItem[]

  @@index([tenantId])
}

model User {
  id              String   @id
  tenantId        String
  personId        String
  email           String
  passwordHash    String
  role            String
  adminGrant      Boolean  @default(false)
  mustSetPassword Boolean  @default(true)
  authEpoch       Int      @default(0)
  // Last forgot-password email; the public route sends at most one a minute per User.
  passwordEmailSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tenantId, personId])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Employment {
  id           String  @id
  tenantId     String
  personId     String
  joinDate     String
  endDate      String?
  status       String
  contractType String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
}

model OrgUnit {
  id       String    @id
  tenantId String
  name     String
  parentId String?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgUnit[] @relation("OrgUnitTree")
  positions Position[]

  @@index([tenantId])
}

model Grade {
  id         String     @id
  tenantId   String
  code       String
  name       String
  positions  Position[]

  @@index([tenantId])
}

model Position {
  id                  String      @id
  tenantId            String
  title               String
  gradeId             String
  orgUnitId           String
  reportsToPositionId String?
  grade               Grade       @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  orgUnit             OrgUnit     @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  reportsTo           Position?   @relation("PositionTree", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports             Position[]  @relation("PositionTree")
  assignments         Assignment[]

  @@index([tenantId])
}

model Assignment {
  id         String   @id
  tenantId   String
  personId   String
  positionId String
  startDate  String
  endDate    String?
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  kpiSets    KpiSet[]

  @@index([tenantId])
  @@index([personId])
  @@index([positionId])
}

model CurriculumVitae {
  id            String  @id
  tenantId      String
  personId      String?
  fileName      String
  uploadedAt    String
  state         String
  extractedText String
  fields        Json
  person        Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model CorrectionRequest {
  id            String @id
  tenantId      String
  personId      String
  field         String
  currentValue  String
  proposedValue String
  status        String
  person        Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KpiCycle {
  id              String   @id
  tenantId        String
  name            String
  year            Int
  status          String
  phase           String?
  planningEndsOn  String?
  adjustmentOpen  Boolean  @default(false)
  checkInCadence  String
  checkInWindows  Json
  kpiSets         KpiSet[]

  @@index([tenantId])
}

model KpiSet {
  id                     String     @id
  tenantId               String
  assignmentId           String
  cycleId                String
  status                 String
  readyForAgreement      Boolean    @default(false)
  lineManagerApprovedBy  String?
  adminApprovedBy        String?
  returnComment          String?
  score                  Float?
  assignment         Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cycle              KpiCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items              KpiItem[]

  @@index([tenantId])
  @@index([assignmentId])
  @@index([cycleId])
}

model KpiItem {
  id               String      @id
  tenantId         String
  kpiSetId         String
  name             String
  definition       String
  target           Float
  unit             String
  weight           Float
  polarity         String
  checkInCadence   String?
  parentKpiItemId  String?
  cascadeMode      String?
  directMix        String?
  kpiSet           KpiSet      @relation(fields: [kpiSetId], references: [id], onDelete: Cascade)
  parent           KpiItem?    @relation("KpiCascade", fields: [parentKpiItemId], references: [id], onDelete: SetNull)
  children         KpiItem[]   @relation("KpiCascade")
  checkIns         CheckIn[]

  @@index([tenantId])
  @@index([kpiSetId])
}

model CheckIn {
  id                    String  @id
  tenantId              String
  kpiItemId             String
  date                  String
  window                String
  actual                Float
  note                  String
  status                String  @default("approved")
  lineManagerApprovedBy String?
  adminApprovedBy       String?
  returnComment         String?
  kpiItem               KpiItem @relation(fields: [kpiItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([kpiItemId])
}

model AuditEntry {
  id            String @id
  tenantId      String
  at            String
  actorRole     String
  actorPersonId String
  action        String
  entity        String
  entityId      String
  detail        String
  actor         Person @relation(fields: [actorPersonId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Project {
  id         String     @id
  tenantId   String
  code       String
  name       String
  clientName String?
  startDate  String
  endDate    String?
  staffings  Staffing[]
  workItems  WorkItem[]
  deliverables Deliverable[]
  timeBlocks TimeBlock[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Staffing {
  id        String  @id
  tenantId  String
  personId  String
  projectId String
  startDate String
  endDate   String?
  load      Int
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@index([projectId])
}

model WorkItem {
  id          String  @id
  tenantId    String
  projectId   String
  name        String
  description String  @default("")
  picPersonId String
  startDate   String
  endDate     String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pic         Person  @relation(fields: [picPersonId], references: [id], onDelete: Restrict)
  timeBlocks  TimeBlock[]

  @@index([tenantId])
  @@index([projectId])
  @@index([picPersonId])
}

model Deliverable {
  id          String @id
  tenantId    String
  projectId   String
  kind        String
  name        String
  statusId    String
  categoryId  String
  url         String?
  versions    Json
  workItemIds Json
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      DeliverableStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  category    DeliverableCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([projectId])
}

model DeliverableStatus {
  id               String @id
  tenantId         String
  name             String
  sortOrder        Int
  isDefault        Boolean @default(false)
  countsAsAccepted Boolean @default(false)
  deliverables     Deliverable[]

  @@index([tenantId])
}

model DeliverableCategory {
  id           String @id
  tenantId     String
  name         String
  sortOrder    Int
  deliverables Deliverable[]

  @@index([tenantId])
}

model LeaveType {
  id            String @id
  tenantId      String
  name          String
  sortOrder     Int
  leaveRequests LeaveRequest[]

  @@index([tenantId])
}

model LeaveRequest {
  id                 String  @id
  tenantId           String
  personId           String
  kind               String
  leaveTypeId        String?
  coverPersonId      String?
  doctorLetterPath   String?
  note               String
  spanMode           String
  startDate          String
  endDate            String
  startTime          String?
  endTime            String?
  decision           String?
  decidedByPersonId  String?
  person             Person  @relation("LeaveSubject", fields: [personId], references: [id], onDelete: Cascade)
  cover              Person? @relation("LeaveCover", fields: [coverPersonId], references: [id], onDelete: SetNull)
  leaveType          LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([personId])
}

model PublicHoliday {
  id         String  @id
  tenantId   String
  date       String
  name       String
  origin     String  @default("internal")
  suppressed Boolean @default(false)
  nameLocked Boolean @default(false)

  @@index([tenantId])
  @@unique([tenantId, date])
}

model TimeBlockType {
  id            String @id
  tenantId      String
  name          String
  sortOrder     Int
  allowsInvites Boolean @default(false)
  timeBlocks    TimeBlock[]

  @@index([tenantId])
}

model TimeBlock {
  id         String  @id
  tenantId   String
  personId   String
  typeId     String
  startAt    String
  endAt      String
  projectId  String?
  workItemId String?
  title      String  @default("")
  person     Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  type       TimeBlockType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  invites    Invite[]

  @@index([tenantId])
  @@index([personId])
}

model Invite {
  id          String @id
  tenantId    String
  timeBlockId String
  personId    String
  status      String
  timeBlock   TimeBlock @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  person      Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([timeBlockId, personId])
  @@index([tenantId])
  @@index([personId])
}

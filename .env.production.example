# Copy to .env.production and fill in real values before deploying.
# docker compose reads this file automatically when named .env, or pass
# --env-file .env.production explicitly.

# Strong random string used to sign session cookies. REQUIRED.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
APP_ORIGIN=https://internal.kmplus.co.id
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Postgres password for the bundled db service.
POSTGRES_PASSWORD=kmplus

# Set to false after the first successful boot so the app does not
# re-push the schema / re-seed on every restart.
RUN_DB_PUSH=true
RUN_DB_SEED=true

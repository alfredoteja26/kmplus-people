# Copy to .env.production and fill in real values before deploying.
# docker compose reads this file automatically when named .env, or pass
# --env-file .env.production explicitly.

# Supabase Postgres (README-DEPLOY.md → Supabase Postgres). REQUIRED.
# Transaction pooler (6543) for the app; session pooler (5432) for prisma db push.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Strong random string used to sign session cookies. REQUIRED.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
APP_ORIGIN=https://internal.kmplus.co.id
# Supabase Auth holds passwords (ADR-0011). Server-only; never NEXT_PUBLIC_.
# Project Settings → API Keys. Legacy anon / service_role keys also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Set-password email goes out through the company mail server (ADR-0011).
# 465 = implicit TLS, 587 = STARTTLS. Unset locally: Supabase's mailer is used instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Schema changes only: one boot with true, then back to false. Production is never seeded.
RUN_DB_PUSH=false

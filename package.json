{
  "name": "kmplus-people",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "db:lockdown": "prisma db execute --schema prisma/schema.prisma --file prisma/supabase-lockdown.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@prisma/client": "^6.16.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/auth-js": "^2.117.3",
    "@supabase/storage-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.9.1",
    "next": "^15.5.3",
    "nodemailer": "^10.0.16",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20.19.13",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "npx tsx --tsconfig tsconfig.json prisma/seed.ts"
  }
}
